{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile=false",
  "buildCommand": "cd ../.. && pnpm --filter @speedy-van/app build",
  "outputDirectory": ".next",
  "regions": ["lhr1"],
  "functions": {
    "src/app/api/**/route.ts": {
      "maxDuration": 30,
      "excludeFiles": "**/node_modules/{react-native,@react-native*,@expo,expo*,jsc-android,hermes-engine,metro*,turbo*,@changesets,@electric-sql,effect,jspdf,playwright*,puppeteer*,canvas,@sentry/replay*,@sentry/profiling-node}/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
